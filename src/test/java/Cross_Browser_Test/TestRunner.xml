<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite">
    <parameter name="webAppURL" value="https://the-internet.herokuapp.com/"/>
    <test name="ChromeTest" enabled="false">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="Cross_Browser_Test.CrossBrowserTCs"/>
        </classes>
    </test>

    <test name="FireFoxTest" enabled="false">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="Cross_Browser_Test.CrossBrowserTCs"/>
        </classes>
    </test>

    <test name="EdgeTest" enabled="true">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="Cross_Browser_Test.CrossBrowserTCs"/>
        </classes>
    </test>
</suite>